extends widget/base
block append head
  - var hasMermaid = /(flowchart|graph|sequenceDiagram|classDiagram|stateDiagram|erDiagram|gantt|pie|gitGraph|mindmap|timeline|journey|quadrantChart|sankey)/.test(page.content)
  - var hasMath = /\$\$|\\\(|\\\[|(^|[^\\$])\$[^$]+\$/.test(page.content)
  link(rel='stylesheet', href= url_for('/style/post.css'))
  link(rel='stylesheet', href= url_for('/style/themes/highlight-theme-light.css'))
  script(src= url_for("/js/highlight.pack.js"))
  if themeConfig.mermaid && themeConfig.mermaid.enable && hasMermaid
    script(src='https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js')
    script.
      if (window.mermaid) {
        mermaid.initialize({ startOnLoad: false, theme: document.documentElement.classList.contains('appearance-dark') ? 'dark' : 'default' });
      }
  if themeConfig.mathjax && themeConfig.mathjax.enable && hasMath
    script.
      window.MathJax = {
        tex: {
          inlineMath: [['$', '$'], ['\\(', '\\)']],
          displayMath: [['$$', '$$'], ['\\[', '\\]']]
        },
        options: {
          skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
        }
      };
    script(async src='https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js')
  meta(name="description", content=truncate( strip_html(page.content), {length: 360, omission: '..'} ))
  if themeConfig.comment_valine && themeConfig.comment_valine.enable
      script(src="//unpkg.com/valine/dist/Valine.min.js")
block topic
    div#postTopic.is-full-height
        - var title = truncate( page.title, {length: 65, omission: '..'} ) || ''
        p.is-full-height.is-flex-shrink-0.is-flex.is-align-items-center.is-justify-content-center= title
        p.is-full-height.is-flex-shrink-0.is-flex.is-align-items-center.is-justify-content-center= __('click_back_to_the_top')

block content
    - var tocContent = toc(page.content, {list_number: false})
    - var plainContent = strip_html(page.content).replace(/\s+/g, ' ').trim()
    - var readingMinutes = Math.max(1, Math.ceil(plainContent.length / 500))
    - var currentPostId = 'post:' + page.path
    - var currentPostUrl = url_for(page.path)
    - var relatedPosts = []
    - var relatedEdges = []
    - site.posts.toArray().forEach(function (post) {
    -   if (post.path === page.path) return
    -   var targetUrl = url_for(post.path)
    -   var linksToPost = page.content.indexOf('href="' + targetUrl + '"') > -1 || page.content.indexOf("href='" + targetUrl + "'") > -1
    -   var linksToCurrent = post.content.indexOf('href="' + currentPostUrl + '"') > -1 || post.content.indexOf("href='" + currentPostUrl + "'") > -1
    -   if (linksToPost || linksToCurrent) {
    -     relatedPosts.push({ id: 'post:' + post.path, label: post.title || post.path, url: targetUrl })
    -     relatedEdges.push({ source: currentPostId, target: 'post:' + post.path })
    -   }
    - })
    - var articleGraphData = JSON.stringify({ nodes: [{ id: currentPostId, label: page.title || page.path, url: currentPostUrl, current: true }].concat(relatedPosts), edges: relatedEdges }).replace(/</g, '\\u003c')
    .reading-progress#readingProgress(aria-hidden='true')
    if tocContent.length > 0
        details.mobile-toc.is-hidden-tablet
            summary Contents
            != tocContent
    main.container.is-max-widescreen.content.section.post-page.pt-4.px-4
        .columns.is-flex-desktop.is-justify-content-center.is-flex-direction-row-reverse
            .column.is-3.is-hidden-mobile
                aside.article-sidebar
                    .music-player.article-music-player#musicPlayer
                        button.music-player-handle(type='button' aria-label='Drag music player') Music
                        iframe.music-player-frame(frameborder='no', border='0', marginwidth='0', marginheight='0', width='330', height='110', src='//music.163.com/outchain/player?type=0&id=7384256108&auto=0&height=90', title='NetEase Cloud Music player')
                    != tocContent
                    if relatedPosts.length > 0
                        section.article-graph-panel
                            h3= __('article_graph')
                            #articleGraph.article-graph-canvas(role='img' aria-label='Article link graph')
                            script#articleGraphData(type='application/json')!= articleGraphData
            .column.is-9
                header.my-4
                    if page.tags && page.tags.length > 0
                        each tag in page.tags.toArray()
                            a(href= url_for(`/tags/${tag.name}`))
                                i.tag.post-item-tag= tag.name
                h1.mt-0.mb-1.is-family-serif#postTitle= page.title
                if page.date
                    time.has-text-grey(datetime=page.date.toJSON())= date(page.date, date_format)
                .post-meta.has-text-grey
                    span= readingMinutes + ' min read'
                    if page.updated && page.updated.valueOf() !== page.date.valueOf()
                        span= ' Updated ' + date(page.updated, date_format)
                article.mt-2.post-content!= page.content
                section.jump-container.is-flex.is-justify-content-space-between.my-6
                    // em is empty placeholder
                    if page.prev
                        - var preContent= `${ __('prev') }: ${ page.prev.title }`
                        a.button.is-default(href= url_for(page.prev.path) title= page.prev.title)
                            i.iconfont.icon-prev.mr-2.has-text-grey
                            span.has-text-weight-semibold= preContent
                    else
                        em
                    if page.next
                        - var nextContent= `${ __('next') }: ${ page.next.title }`
                        a.button.is-default(href= url_for(page.next.path) title= page.next.title)
                            span.has-text-weight-semibold= nextContent
                            i.iconfont.icon-next.ml-2.has-text-grey
                if themeConfig.comment_utteranc && themeConfig.comment_utteranc.enable
                    article.mt-6.comment-container#utterances(
                        data-repo= themeConfig.comment_utteranc.repo
                        data-label= themeConfig.comment_utteranc.label
                        data-issue-term= themeConfig.comment_utteranc.issue_term || 'pathname'
                        data-theme= themeConfig.comment_utteranc.theme || 'preferred-color-scheme'
                    )
                if themeConfig.comment_valine && themeConfig.comment_valine.enable
                    article.mt-6.comment-container#vcomments(
                        data-comment_valine_id= themeConfig.comment_valine.appId
                        data-comment_valine_key= themeConfig.comment_valine.appKey
                    )
                if themeConfig.comment_disqus && themeConfig.comment_disqus.enable
                    div#disqus_thread
                    article.mt-6.comment-container#disqus
                        script="var disqus_config = function () {this.page.url = '"+themeConfig.comment_disqus.url+url_for(page.path)+"';this.page.identifier = '"+themeConfig.comment_disqus.name+"';};"
                        script="(function() {var d = document, s = d.createElement('script');s.src = 'https://"+themeConfig.comment_disqus.name+".disqus.com/embed.js';s.setAttribute('data-timestamp', +new Date());(d.head || d.body).appendChild(s);})();"
                        script(id="dsq-count-scr", src="//blog-pubgj2togw.disqus.com/count.js", async)
block script
    script(src= url_for("/js/post.js"))
    if relatedPosts.length > 0
        script(src= url_for("/js/article-graph.js"))
